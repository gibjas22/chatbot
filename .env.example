# Copy to .env (git-ignored) and fill in, or set these in your shell.
# Placeholders only. Never commit a real key.
#
# Optional. Set this to run a deployment where visitors do not supply a key.
# When it is unset, the app asks each visitor for their own key instead, and
# that key is used only for their browser session.
#
# A deployment-wide key means every visitor spends your credit, so keep the
# per-session request limit in chat_core.py in mind before exposing it publicly.
OPENAI_API_KEY=sk-your-key-here
